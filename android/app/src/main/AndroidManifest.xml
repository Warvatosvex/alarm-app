<?xml version="1.0" encoding="utf-16"?>
<manifest xmlns:android="http://android.com" xmlns:tools="http://android.com">
  <uses-permission tools:name="android.permission.INTERNET" />
  <uses-permission tools:name="android.permission.WAKE_LOCK" />
  <uses-permission tools:name="android.permission.VIBRATE" />
  <uses-permission tools:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission tools:name="android.permission.SCHEDULE_EXACT_ALARM" />
  <uses-permission tools:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission tools:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <uses-permission tools:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission tools:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission tools:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission tools:name="android.permission.REORDER_TASKS" />
  <application tools:roundIcon="@mipmap/ic_launcher_round" tools:theme="@style/AppTheme" tools:icon="@mipmap/ic_launcher" tools:supportsRtl="true" tools:allowBackup="true" tools:label="@string/app_name" tools:replace="android:allowBackup">
    <activity tools:launchMode="singleTask" tools:label="@string/title_activity_main" tools:turnScreenOn="true" tools:showWhenLocked="true" tools:exported="true" tools:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation" tools:name=".MainActivity" tools:theme="@style/AppTheme.NoActionBarLaunch">
      <intent-filter>
        <action tools:name="android.intent.action.MAIN" />
